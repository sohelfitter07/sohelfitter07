rules_version = '2';

// Canadian Fitness Repair — Firestore security rules
//
// Default deny. Every read and write is rejected unless a rule below
// explicitly allows it. Only authenticated admins (custom claim
// `admin == true`) may access the appointments, customers, logs, and
// settings collections.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: true only for signed-in users carrying the admin claim.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // Core business collections: admin-only.
    match /appointments/{appointmentId} {
      allow read, write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Admin settings used by the current tracker until it is fully migrated.
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
