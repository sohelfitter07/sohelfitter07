# Normalize line endings in the repository
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Source text (explicit, so editors don't flip them)
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.xml  text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf

# Binary assets — never convert or diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pdf  binary
*.zip  binary
