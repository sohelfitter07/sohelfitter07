# ---------------------------------------------------------------------------
# Firebase client SDK (safe to expose in the browser)
# Firebase Console -> Project settings -> General -> Your apps -> Web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional client settings
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server only - never expose these to the browser)
# Firebase Console -> Project settings -> Service accounts -> Generate key
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the newlines escaped as \n when pasting into a single-line env var.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Admin allowlist
# The single admin account that is allowed to create a dashboard session.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
